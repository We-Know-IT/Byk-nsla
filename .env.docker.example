# Copy to .env in the repository root: cp .env.docker.example .env
#
# Local full stack:  docker compose up --build
# Production (DO Managed DB): docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d

# --- Local Postgres (db service) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=bykansla
POSTGRES_PORT=5432

# Backend — use hostname "db" inside Docker Compose
DATABASE_URL=postgresql://admin:adminpassword@db:5432/bykansla
BACKEND_PORT=4000
WEATHER_PROVIDER=mock

# Web — server-side fetch to backend on the Compose network
BACKEND_URL=http://backend:4000
WEB_PORT=3000
APP_URL=http://localhost:3000

# Web — public URL for browser and SSR (rebuild web image after changing)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Production example (Managed PostgreSQL on DigitalOcean) ---
# DATABASE_URL=postgresql://user:pass@host:25060/bykansla?sslmode=require
# APP_URL=https://app.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
