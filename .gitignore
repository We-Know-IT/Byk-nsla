# ─── Fork-friendly root ignores ─────────────────────────────────────────────
# Keeps local junk, secrets, and build artifacts out of git when people extend
# the repo with their own tools, editors, or subfolders.

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# --- Environment & secrets (keep *.example committed) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Dependencies & package managers ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build & caches ---
dist/
build/
out/
.next/
.turbo/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# --- IDE & editors ---
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.project
.classpath
.settings/
*.code-workspace

# VS Code — local-only by default; commit e.g. extensions.json when you want team defaults
.vscode/*
!.vscode/extensions.json

# --- Local tooling & misc ---
.vercel
.netlify
tmp/
temp/
*.local
*.bak
*.tmp
.agent.md

# --- Optional: other stacks people might add next to web/backend ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
target/
.gradle/
*.class
vendor/
.bundle/

# --- Test / e2e artifacts (if added later) ---
playwright-report/
test-results/
blob-report/
